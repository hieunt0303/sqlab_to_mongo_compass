# Fake MongoDB Wire Protocol Server Configuration

# The local port for the Fake MongoDB Server
PORT=27017

# Upstream Urbox SQL editor API credentials (Get from browser DevTools -> Network tab)
# Look for: POST https://query.urbox.services/api/v1/sqllab/execute/
UPSTREAM_CSRF_TOKEN=your_upstream_csrf_token_here
UPSTREAM_SESSION_COOKIE=your_upstream_session_cookie_here

# Upstream SQL settings
UPSTREAM_CLIENT_ID=dFwtVCgIyg
UPSTREAM_DATABASE_ID=54
UPSTREAM_SQL_EDITOR_ID=188
UPSTREAM_SCHEMA=uc_logs
